---
import type { Project } from "../../constants/projects";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---
<article class="project-card">
    <div class="project-card__media">
        {project.image ? (
            <img src={project.image} alt={project.name} loading="lazy" />
        ) : (
            <svg class="project-card__placeholder" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 6.5C3 5.67157 3.67157 5 4.5 5H9.17157C9.70201 5 10.2107 5.21071 10.5858 5.58579L11.9142 6.91421C12.2893 7.28929 12.7979 7.5 13.3284 7.5H19.5C20.3284 7.5 21 8.17157 21 9V17.5C21 18.3284 20.3284 19 19.5 19H4.5C3.67157 19 3 18.3284 3 17.5V6.5Z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M9 13.5L11 15.5L15.5 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        )}
    </div>
    <div class="project-card__body">
        <h2 class="project-card__title heading-sm">{project.name}</h2>
        <p class="project-card__description">{project.description.es}</p>
        <a class="project-card__link" href={project.repo} target="_blank" rel="noopener noreferrer">
            Ver repositorio →
        </a>
    </div>
</article>
<style>
    .project-card {
        display: flex;
        flex-direction: column;
        background: rgba(9, 9, 10, 0.75);
        border: 1px solid var(--color-green);
        border-radius: var(--radius-lg);
        box-shadow: 0 0 6px rgba(0, 255, 0, 0.25), inset 0 0 20px rgba(0, 255, 0, 0.03);
        overflow: hidden;
        transition: box-shadow 0.2s ease-out, transform 0.2s ease-out;
    }

    .project-card:hover {
        box-shadow: 0 0 16px rgba(0, 255, 0, 0.55), inset 0 0 25px rgba(0, 255, 0, 0.06);
        transform: translateY(-2px);
    }

    .project-card__media {
        width: 100%;
        aspect-ratio: 16 / 9;
        display: flex;
        justify-content: center;
        align-items: center;
        border-bottom: 1px dashed rgba(0, 255, 0, 0.4);
        background: rgba(0, 255, 0, 0.03);
    }

    .project-card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .project-card__placeholder {
        width: 2.5rem;
        height: 2.5rem;
        color: var(--color-green);
        opacity: 0.6;
    }

    .project-card__body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
        flex: 1;
    }

    .project-card__title {
        color: var(--color-white);
    }

    .project-card__description {
        color: var(--color-gray);
        font-size: 0.9rem;
        flex: 1;
    }

    .project-card__link {
        align-self: flex-start;
        color: var(--color-green);
        font-size: 0.9rem;
        text-decoration: none;
    }

    .project-card__link:hover {
        text-decoration: underline;
    }
</style>
