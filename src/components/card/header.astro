---
<section id="intro" class="w-full h-fit shrink-0 px-4 sm:px-8 py-4 flex flex-col sm:flex-row justify-center gap-6 sm:gap-0 sm:justify-between items-center">
    <div class="w-fit h-fit flex flex-col gap-2 order-last sm:order-none">
        <h1 id="greeting" class="text-white text-2xl sm:text-4xl font-bold greeting greeting-shadow">Hola, Mundo! Soy Angyee</h1>
        <div class="w-full sm:w-[500px] bg-black px-3">
            <h2 id="knowledge" class="text-gray text-xl knowlegde" />
        </div>
    </div>
    <div class="w-32 h-32 sm:w-72 sm:h-73 rounded-full shrink-0 overflow-hidden">
		<img src="/angyee.jpg" class="w-full h-full object-cover" />
	</div>
</section>
<script is:inline>
	const textGreeting = document.querySelector('.greeting');
	const textKnowledge = document.getElementById('knowledge');

	function animateConsole() {
		if (textGreeting) {
			const str = textGreeting.textContent;
			const typingSpeed = 100;
			let i = 0;

			function writing() {
				if ((str) && (i < str.length) && (textGreeting)) {
					textGreeting.textContent = str.substring(0, i + 1);
					i++;
					setTimeout(writing, typingSpeed);
				}	
			}

			writing();
		}
	}

	function animateKnowledge() {
		let knowledges = ["Desarrolladora de Software", "Analista de Datos", "Hacedora de Soluciones"]
		let knowledgeIndex = 0;
		let startTime = 3000;

		function startAnimation() {
			if (textKnowledge) textKnowledge.textContent = knowledges[knowledgeIndex];
			setTimeout(() => {
				textKnowledge?.classList.add('knowlegde-animation-start');
				setTimeout(() => {
					textKnowledge?.classList.remove('knowlegde-animation-start');
					textKnowledge?.classList.add('knowlegde-animation-end');
					setTimeout(() => {
						textKnowledge?.classList.remove('knowlegde-animation-end');
						knowledgeIndex = (knowledgeIndex + 1) % knowledges.length;
						startTime = 300;
						startAnimation();
					}, 2500);
				}, 5000);
			}, startTime);
		}

		startAnimation();
	}

	animateConsole();
	animateKnowledge();
</script>
<style>
	.console {
        overflow: hidden;
        border-right: .15em solid white;
        white-space: nowrap;
        margin: 0 auto;
    }

	.greeting-shadow {
		text-shadow: 0px 5px 5px var(--color-black);
		animation: greeting-animation 10s ease-in-out infinite;
	}

	.knowlegde {
		width: 100%;
		height: 100%;
		position: relative;
		opacity: 0;
	}

	.knowlegde-animation-start {
		animation: knowlegde-animate-start 3s forwards;
	}

	.knowlegde-animation-end {
		animation: knowlegde-animate-end 3s forwards;
	}

	@keyframes greeting-animation {
		0% { text-shadow: 0px 5px 5px var(--color-black); } 
		25% { text-shadow: 0px 5px 5px rgb(21, 239, 255); }
		50% { text-shadow: 0px 5px 5px rgb(255, 2, 171); } 
		75% { text-shadow: 0px 5px 5px rgb(93, 235, 93); } 
		100% { text-shadow: 0px 5px 5px var(--color-black); }
	}

	@keyframes knowlegde-animate-start {
		0% {
			opacity: 0;
			left: 50%;
		} 100% {
			opacity: 1;
			left: 0%;
		}
	}

	@keyframes knowlegde-animate-end {
		0% {
			opacity: 1;
			left: 0%;
		} 100% {
			opacity: 0;
			left: 50%;
		}
	}

</style>
