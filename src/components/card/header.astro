---
---
<section id="intro" class="w-full h-fit shrink-0 px-4 sm:px-8 py-4 flex flex-col lg:flex-row justify-center items-center gap-6 sm:gap-12">
    <div class="w-fit h-fit flex flex-col gap-2 order-last lg:order-none">
        <h1 id="greeting" class="text-white heading-lg greeting-shadow flex items-baseline">
            <span id="greeting-text"></span><span id="greeting-cursor" class="cursor">_</span>
        </h1>
        <div class="w-full sm:w-[500px] bg-black px-3 min-h-[1.75rem] flex items-baseline gap-1">
            <h2 id="knowledge-text" class="text-gray text-xl"></h2><span id="knowledge-cursor" class="cursor">_</span>
        </div>
        <div class="flex flex-wrap gap-3 mt-2">
            <a class="btn" href="/cv/CV%20-%20Angyee%20Mar%C3%ADn.pdf" download>Descargar CV (ES)</a>
            <a class="btn" href="/cv/Angyee%20Mar%C3%ADn.pdf" download>Download CV (EN)</a>
        </div>
    </div>
    <div class="photo-frame w-32 h-32 sm:w-72 sm:h-72 lg:w-56 lg:h-56 shrink-0">
		<img src="/angyee.jpg" alt="Angyee Marín" class="photo-frame__img" />
		<span class="photo-frame__corner photo-frame__corner--tl" aria-hidden="true"></span>
		<span class="photo-frame__corner photo-frame__corner--tr" aria-hidden="true"></span>
		<span class="photo-frame__corner photo-frame__corner--bl" aria-hidden="true"></span>
		<span class="photo-frame__corner photo-frame__corner--br" aria-hidden="true"></span>
	</div>
</section>
<script is:inline>
	const GREETING_TEXT = "Hola, Mundo! Soy Angyee";
	const KNOWLEDGE_PHRASES = ["Desarrolladora de Software", "Analista de Datos", "Hacedora de Soluciones"];
	const TYPE_SPEED_MS = 70;
	const DELETE_SPEED_MS = 40;
	const PHRASE_PAUSE_MS = 2200;
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function typeText(el, text, speed, onDone) {
		let i = 0;
		(function step() {
			el.textContent = text.slice(0, i);
			i++;
			if (i <= text.length) setTimeout(step, speed);
			else if (onDone) onDone();
		})();
	}

	function deleteText(el, speed, onDone) {
		(function step() {
			const text = el.textContent ?? "";
			el.textContent = text.slice(0, -1);
			if (text.length > 1) setTimeout(step, speed);
			else if (onDone) onDone();
		})();
	}

	function animateGreeting(onDone) {
		const el = document.getElementById('greeting-text');
		const cursor = document.getElementById('greeting-cursor');
		if (!el) return;

		if (prefersReducedMotion) {
			el.textContent = GREETING_TEXT;
			cursor?.classList.add('cursor-idle');
			if (onDone) onDone();
			return;
		}

		typeText(el, GREETING_TEXT, TYPE_SPEED_MS, () => {
			cursor?.classList.add('cursor-idle');
			if (onDone) onDone();
		});
	}

	function animateKnowledge() {
		const el = document.getElementById('knowledge-text');
		if (!el) return;

		if (prefersReducedMotion) {
			el.textContent = KNOWLEDGE_PHRASES[0];
			return;
		}

		let index = 0;

		function loop() {
			typeText(el, KNOWLEDGE_PHRASES[index], TYPE_SPEED_MS, () => {
				setTimeout(() => {
					deleteText(el, DELETE_SPEED_MS, () => {
						index = (index + 1) % KNOWLEDGE_PHRASES.length;
						loop();
					});
				}, PHRASE_PAUSE_MS);
			});
		}

		loop();
	}

	animateGreeting(animateKnowledge);
</script>
<style>
	/* Defensive: on very short viewports (e.g. phone landscape),
	   shrink the header so it can't push the terminal below it
	   down to an unusable sliver. */
	@media (max-height: 500px) {
		#intro {
			padding-top: 0.25rem;
			padding-bottom: 0.25rem;
		}

		#intro .photo-frame {
			width: 4rem !important;
			height: 4rem !important;
		}
	}

	.photo-frame {
		position: relative;
	}

	.photo-frame__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0.75rem;
		display: block;
	}

	.photo-frame__corner {
		position: absolute;
		width: 1.1rem;
		height: 1.1rem;
		border: 2px solid var(--color-green);
		filter: drop-shadow(0 0 3px var(--color-green));
	}

	.photo-frame__corner--tl {
		top: -0.45rem;
		left: -0.45rem;
		border-right: none;
		border-bottom: none;
		border-top-left-radius: 0.35rem;
	}

	.photo-frame__corner--tr {
		top: -0.45rem;
		right: -0.45rem;
		border-left: none;
		border-bottom: none;
		border-top-right-radius: 0.35rem;
	}

	.photo-frame__corner--bl {
		bottom: -0.45rem;
		left: -0.45rem;
		border-right: none;
		border-top: none;
		border-bottom-left-radius: 0.35rem;
	}

	.photo-frame__corner--br {
		bottom: -0.45rem;
		right: -0.45rem;
		border-left: none;
		border-top: none;
		border-bottom-right-radius: 0.35rem;
	}

	.greeting-shadow {
		animation: glow-pulse 4s ease-in-out infinite;
	}

	.cursor {
		display: inline-block;
		color: var(--color-green);
		margin-left: 0.1em;
		animation: blink 0.9s steps(1) infinite;
	}

	.cursor-idle {
		opacity: 0.5;
		animation: blink 0.9s steps(1) infinite;
	}

	@keyframes glow-pulse {
		0%, 100% { text-shadow: 0 0 6px var(--color-green); }
		50% { text-shadow: 0 0 16px var(--color-green); }
	}

	@keyframes blink {
		0%, 50% { opacity: 1; }
		50.01%, 100% { opacity: 0; }
	}
</style>
